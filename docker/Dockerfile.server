# puppetc-server container
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libyaml-0-2 \
    libssl3 \
    libmicrohttpd12 \
    libruby3.1 \
    && rm -rf /var/lib/apt/lists/*

# Copy built binaries and libraries from builder
COPY --from=builder /install/usr/bin/puppetc-server /usr/bin/
COPY --from=builder /install/usr/lib/libpuppetc.so* /usr/lib/
COPY --from=builder /install/usr/lib/libfacter_c.so* /usr/lib/

# Update library cache
RUN ldconfig

# Create directories for manifests and modules
RUN mkdir -p /etc/puppet/manifests /etc/puppet/modules /etc/puppet/hiera

# Default port
EXPOSE 8140

# Default command
ENTRYPOINT ["puppetc-server"]
CMD ["-v", "/etc/puppet"]
