# MyApp Configuration
# Generated by Puppet for node <%= @hostname %>

[server]
hostname = <%= @hostname %>
role = <%= @role %>
environment = <%= @environment %>
global_setting = <%= @global_var %>

[database]
<% if @role == "webserver" %>
# Web server database connection
db_host = db01.<%= @domain || "example.com" %>
db_name = myapp_<%= @environment %>
<% elsif @role == "database" %>
# Database server settings
bind_address = 0.0.0.0
max_connections = 100
<% end %>

[system]
os = <%= @operatingsystem %>
os_release = <%= @operatingsystemrelease %>
architecture = <%= @architecture %>

# Facts available:
# Hostname: <%= @hostname %>
# FQDN: <%= @fqdn %>
# IP Address: <%= @ipaddress %>