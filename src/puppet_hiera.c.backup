/**
 * @file puppet_hiera.c
 * @brief Hiera data lookup implementation
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include "puppet_hiera.h"
#include "puppet_memory.h"
#include "puppet_stdlib.h"

#ifdef HAVE_YAML

/**
 * @brief Convert YAML node to Puppet value
 */
static puppet_value_t *yaml_node_to_puppet_value(yaml_node_t *node, yaml_document_t *document);

/**
 * @brief Convert YAML sequence to Puppet array
 */
static puppet_value_t *yaml_sequence_to_array(yaml_node_t *node, yaml_document_t *document) {
    puppet_value_t *array = puppet_value_create_array();
    
    for (yaml_node_item_t *item = node->data.sequence.items.start;
         item < node->data.sequence.items.top; item++) {
        yaml_node_t *value_node = yaml_document_get_node(document, *item);
        if (value_node) {
            puppet_value_t *value = yaml_node_to_puppet_value(value_node, document);
            if (value) {
                puppet_array_append(array->data.array, value);
            }
        }
    }
    
    return array;
}

/**
 * @brief Convert YAML mapping to Puppet hash
 */
static puppet_value_t *yaml_mapping_to_hash(yaml_node_t *node, yaml_document_t *document) {
    puppet_value_t *hash = puppet_value_create_hash();
    
    for (yaml_node_pair_t *pair = node->data.mapping.pairs.start;
         pair < node->data.mapping.pairs.top; pair++) {
        yaml_node_t *key_node = yaml_document_get_node(document, pair->key);
        yaml_node_t *value_node = yaml_document_get_node(document, pair->value);
        
        if (key_node && value_node && key_node->type == YAML_SCALAR_NODE) {
            char *key = puppet_strdup((char *)key_node->data.scalar.value);
            puppet_value_t *value = yaml_node_to_puppet_value(value_node, document);
            if (value) {
                puppet_hash_set(hash->data.hash, key, strlen(key), value);
            }
            puppet_free(key);
        }
    }
    
    return hash;
}

/**
 * @brief Convert YAML scalar to appropriate Puppet value type
 */
static puppet_value_t *yaml_scalar_to_value(yaml_node_t *node) {
    char *scalar = (char *)node->data.scalar.value;
    
    /* Check for boolean values */
    if (strcmp(scalar, "true") == 0 || strcmp(scalar, "yes") == 0 || 
        strcmp(scalar, "on") == 0 || strcmp(scalar, "TRUE") == 0) {
        return puppet_value_create_boolean(1);
    }
    if (strcmp(scalar, "false") == 0 || strcmp(scalar, "no") == 0 || 
        strcmp(scalar, "off") == 0 || strcmp(scalar, "FALSE") == 0) {
        return puppet_value_create_boolean(0);
    }
    
    /* Check for null */
    if (strcmp(scalar, "null") == 0 || strcmp(scalar, "~") == 0 || 
        strcmp(scalar, "NULL") == 0 || strlen(scalar) == 0) {
        return puppet_value_create_undef();
    }
    
    /* Check for number */
    char *endptr;
    double num = strtod(scalar, &endptr);
    if (*endptr == '\0') {
        return puppet_value_create_number(num);
    }
    
    /* Default to string */
    return puppet_value_create_string(puppet_strdup(scalar));
}

/**
 * @brief Convert YAML node to Puppet value
 */
static puppet_value_t *yaml_node_to_puppet_value(yaml_node_t *node, yaml_document_t *document) {
    if (!node) return NULL;
    
    switch (node->type) {
        case YAML_SCALAR_NODE:
            return yaml_scalar_to_value(node);
            
        case YAML_SEQUENCE_NODE:
            return yaml_sequence_to_array(node, document);
            
        case YAML_MAPPING_NODE:
            return yaml_mapping_to_hash(node, document);
            
        default:
            return NULL;
    }
}

/**
 * @brief Load YAML file into Puppet value
 */
puppet_value_t *puppet_hiera_load_yaml(const char *filepath) {
    FILE *file = fopen(filepath, "r");
    if (!file) {
        return NULL;
    }
    
    yaml_parser_t parser;
    yaml_document_t document;
    puppet_value_t *result = NULL;
    
    if (!yaml_parser_initialize(&parser)) {
        fclose(file);
        return NULL;
    }
    
    yaml_parser_set_input_file(&parser, file);
    
    if (yaml_parser_load(&parser, &document)) {
        yaml_node_t *root = yaml_document_get_root_node(&document);
        if (root) {
            result = yaml_node_to_puppet_value(root, &document);
        }
        yaml_document_delete(&document);
    }
    
    yaml_parser_delete(&parser);
    fclose(file);
    
    return result;
}

#else /* !HAVE_YAML */

puppet_value_t *puppet_hiera_load_yaml(const char *filepath) {
    fprintf(stderr, "Error: YAML support not compiled in\n");
    return NULL;
}

#endif /* HAVE_YAML */

/**
 * @brief Create default hierarchy
 */
static puppet_hiera_level_t *create_default_hierarchy(const char *datadir) {
    puppet_hiera_level_t *hierarchy = NULL;
    puppet_hiera_level_t *last = NULL;
    
    /* Common patterns for Puppet hierarchy */
    const char *patterns[] = {
        "nodes/%{::trusted.certname}.yaml",
        "nodes/%{::fqdn}.yaml",
        "nodes/%{::hostname}.yaml",
        "environment/%{::environment}.yaml",
        "os/%{::osfamily}.yaml",
        "common.yaml",
        NULL
    };
    
    for (int i = 0; patterns[i]; i++) {
        puppet_hiera_level_t *level = puppet_calloc(1, sizeof(puppet_hiera_level_t));
        level->name = puppet_strdup(patterns[i]);
        level->path_template = puppet_strdup(patterns[i]);
        level->datadir = puppet_strdup(datadir);
        level->backend = HIERA_BACKEND_YAML;
        
        if (last) {
            last->next = level;
        } else {
            hierarchy = level;
        }
        last = level;
    }
    
    return hierarchy;
}

/**
 * @brief Create Hiera configuration from file
 */
puppet_hiera_config_t *puppet_hiera_config_create(const char *config_path) {
#ifdef HAVE_YAML
    puppet_value_t *config_data = puppet_hiera_load_yaml(config_path);
    if (!config_data || config_data->type != PUPPET_VALUE_HASH) {
        if (config_data) puppet_value_destroy(config_data);
        return NULL;
    }
    
    puppet_hiera_config_t *config = puppet_calloc(1, sizeof(puppet_hiera_config_t));
    config->version = 5;
    config->default_merge = HIERA_MERGE_FIRST;
    config->cache = puppet_hash_create();
    config->defaults = puppet_hash_create();
    
    /* Extract datadir */
    puppet_value_t *defaults = puppet_hash_get(config_data->data.hash, "defaults", strlen("defaults"));
    if (defaults && defaults->type == PUPPET_VALUE_HASH) {
        puppet_value_t *datadir = puppet_hash_get(defaults->data.hash, "datadir", strlen("datadir"));
        if (datadir && datadir->type == PUPPET_VALUE_STRING) {
            config->datadir = puppet_strdup(datadir->data.string);
        }
    }
    
    /* Default datadir if not specified */
    if (!config->datadir) {
        config->datadir = puppet_strdup("data");
    }
    
    /* Parse hierarchy */
    puppet_value_t *hierarchy = puppet_hash_get(config_data->data.hash, "hierarchy", strlen("hierarchy"));
    if (hierarchy && hierarchy->type == PUPPET_VALUE_ARRAY) {
        puppet_hiera_level_t *last = NULL;
        
        for (size_t i = 0; i < hierarchy->data.array->count; i++) {
            puppet_value_t *level_data = hierarchy->data.array->values[i];
            if (level_data && level_data->type == PUPPET_VALUE_HASH) {
                puppet_hiera_level_t *level = puppet_calloc(1, sizeof(puppet_hiera_level_t));
                
                /* Get level name */
                puppet_value_t *name = puppet_hash_get(level_data->data.hash, "name", strlen("name"));
                if (name && name->type == PUPPET_VALUE_STRING) {
                    level->name = puppet_strdup(name->data.string);
                }
                
                /* Get path or paths */
                puppet_value_t *path = puppet_hash_get(level_data->data.hash, "path", strlen("path"));
                puppet_value_t *paths = puppet_hash_get(level_data->data.hash, "paths", strlen("paths"));
                
                if (path && path->type == PUPPET_VALUE_STRING) {
                    level->path_template = puppet_strdup(path->data.string);
                } else if (paths && paths->type == PUPPET_VALUE_ARRAY && paths->data.array->count > 0) {
                    /* For now, just use first path */
                    puppet_value_t *first_path = paths->data.array->values[0];
                    if (first_path && first_path->type == PUPPET_VALUE_STRING) {
                        level->path_template = puppet_strdup(first_path->data.string);
                    }
                }
                
                /* Get datadir for this level */
                puppet_value_t *level_datadir = puppet_hash_get(level_data->data.hash, "datadir", strlen("datadir"));
                if (level_datadir && level_datadir->type == PUPPET_VALUE_STRING) {
                    level->datadir = puppet_strdup(level_datadir->data.string);
                } else {
                    level->datadir = puppet_strdup(config->datadir);
                }
                
                level->backend = HIERA_BACKEND_YAML;
                
                if (last) {
                    last->next = level;
                } else {
                    config->hierarchy = level;
                }
                last = level;
            }
        }
    }
    
    /* If no hierarchy defined, use defaults */
    if (!config->hierarchy) {
        config->hierarchy = create_default_hierarchy(config->datadir);
    }
    
    puppet_value_destroy(config_data);
    return config;
#else
    fprintf(stderr, "Error: YAML support not compiled in\n");
    return NULL;
#endif
}

/**
 * @brief Create default Hiera configuration
 */
puppet_hiera_config_t *puppet_hiera_config_create_default(const char *datadir) {
    puppet_hiera_config_t *config = puppet_calloc(1, sizeof(puppet_hiera_config_t));
    config->version = 5;
    config->default_merge = HIERA_MERGE_FIRST;
    config->datadir = puppet_strdup(datadir ? datadir : "data");
    config->hierarchy = create_default_hierarchy(config->datadir);
    config->cache = puppet_hash_create();
    config->defaults = puppet_hash_create();
    return config;
}

/**
 * @brief Destroy Hiera configuration
 */
void puppet_hiera_config_destroy(puppet_hiera_config_t *config) {
    if (!config) return;
    
    /* Free hierarchy */
    puppet_hiera_level_t *level = config->hierarchy;
    while (level) {
        puppet_hiera_level_t *next = level->next;
        puppet_free(level->name);
        puppet_free(level->path_template);
        puppet_free(level->datadir);
        puppet_free(level);
        level = next;
    }
    
    puppet_free(config->datadir);
    if (config->cache) puppet_hash_destroy(config->cache);
    if (config->defaults) puppet_hash_destroy(config->defaults);
    puppet_free(config);
}

/**
 * @brief Create Hiera context
 */
puppet_hiera_context_t *puppet_hiera_context_create(
    puppet_hiera_config_t *config,
    puppet_env_t *env
) {
    puppet_hiera_context_t *context = puppet_calloc(1, sizeof(puppet_hiera_context_t));
    context->config = config;
    context->env = env;
    context->variables = puppet_hash_create();
    
    /* Set up variables for interpolation */
    if (env) {
        /* Add environment name */
        if (env->current_node) {
            puppet_hash_set(context->variables, "::environment", strlen("::environment"),
                puppet_value_create_string(puppet_strdup("production")));
        }
        
        /* Add node/certname */
        if (env->current_node) {
            context->node = puppet_strdup(env->current_node);
            puppet_hash_set(context->variables, "::trusted.certname", strlen("::trusted.certname"),
                puppet_value_create_string(puppet_strdup(env->current_node)));
            puppet_hash_set(context->variables, "::fqdn", strlen("::fqdn"),
                puppet_value_create_string(puppet_strdup(env->current_node)));
            puppet_hash_set(context->variables, "::hostname", strlen("::hostname"),
                puppet_value_create_string(puppet_strdup(env->current_node)));
        }
        
        /* Add facts */
        if (env->facts_db && env->facts_db->current_facts) {
            context->facts = env->facts_db->current_facts;
            
            /* Add common facts to variables for interpolation */
            puppet_value_t *osfamily = puppet_hash_get(context->facts, "osfamily", strlen("osfamily"));
            if (osfamily) {
                puppet_hash_set(context->variables, "::osfamily", strlen("::osfamily"), puppet_value_copy(osfamily));
            }
        }
    }
    
    return context;
}

/**
 * @brief Destroy Hiera context
 */
void puppet_hiera_context_destroy(puppet_hiera_context_t *context) {
    if (!context) return;
    
    puppet_free(context->environment);
    puppet_free(context->node);
    if (context->variables) puppet_hash_destroy(context->variables);
    puppet_free(context);
}

/**
 * @brief Interpolate string with context variables
 */
char *puppet_hiera_interpolate(const char *template, puppet_hiera_context_t *context) {
    if (!template) return NULL;
    
    /* Simple implementation - replace %{var} with values */
    size_t result_size = strlen(template) * 2 + 1;
    char *result = puppet_malloc(result_size);
    size_t result_pos = 0;
    
    const char *pos = template;
    while (*pos) {
        if (pos[0] == '%' && pos[1] == '{') {
            /* Find end of variable */
            const char *end = strchr(pos + 2, '}');
            if (end) {
                /* Extract variable name */
                size_t var_len = end - (pos + 2);
                char *var_name = puppet_malloc(var_len + 1);
                strncpy(var_name, pos + 2, var_len);
                var_name[var_len] = '\0';
                
                /* Look up variable */
                puppet_value_t *value = NULL;
                
                /* First check context variables */
                if (context->variables) {
                    value = puppet_hash_get(context->variables, var_name, strlen(var_name));
                }
                
                /* Then check facts */
                if (!value && context->facts) {
                    value = puppet_hash_get(context->facts, var_name, strlen(var_name));
                }
                
                /* Then check environment variables */
                if (!value && context->env) {
                    value = puppet_variable_lookup_chain(context->env, var_name);
                }
                
                /* Add value or keep placeholder */
                if (value && value->type == PUPPET_VALUE_STRING) {
                    size_t value_len = strlen(value->data.string);
                    if (result_pos + value_len >= result_size) {
                        result_size = (result_pos + value_len) * 2;
                        result = puppet_realloc(result, result_size);
                    }
                    strcpy(result + result_pos, value->data.string);
                    result_pos += value_len;
                } else {
                    /* Keep placeholder if not found */
                    size_t placeholder_len = end - pos + 1;
                    if (result_pos + placeholder_len >= result_size) {
                        result_size = (result_pos + placeholder_len) * 2;
                        result = puppet_realloc(result, result_size);
                    }
                    strncpy(result + result_pos, pos, placeholder_len);
                    result_pos += placeholder_len;
                }
                
                puppet_free(var_name);
                pos = end + 1;
            } else {
                /* No closing brace, copy as-is */
                result[result_pos++] = *pos++;
            }
        } else {
            /* Regular character */
            if (result_pos >= result_size - 1) {
                result_size *= 2;
                result = puppet_realloc(result, result_size);
            }
            result[result_pos++] = *pos++;
        }
    }
    
    result[result_pos] = '\0';
    return result;
}

/**
 * @brief Merge values according to strategy
 */
puppet_value_t *puppet_hiera_merge_values(
    puppet_value_t *existing,
    puppet_value_t *new,
    puppet_hiera_merge_t strategy
) {
    if (!existing) return new;
    if (!new) return existing;
    
    switch (strategy) {
        case HIERA_MERGE_FIRST:
            /* First value wins, return existing */
            return existing;
            
        case HIERA_MERGE_UNIQUE:
            /* Array merge with unique values */
            if (existing->type == PUPPET_VALUE_ARRAY && new->type == PUPPET_VALUE_ARRAY) {
                puppet_value_t *result = puppet_value_create_array();
                
                /* Add all existing values */
                for (size_t i = 0; i < existing->data.array->count; i++) {
                    puppet_array_append(result->data.array, 
                        puppet_value_copy(existing->data.array->values[i]));
                }
                
                /* Add new values if not already present */
                for (size_t i = 0; i < new->data.array->count; i++) {
                    int found = 0;
                    for (size_t j = 0; j < existing->data.array->count; j++) {
                        if (puppet_value_equals(new->data.array->values[i], 
                                               existing->data.array->values[j])) {
                            found = 1;
                            break;
                        }
                    }
                    if (!found) {
                        puppet_array_append(result->data.array,
                            puppet_value_copy(new->data.array->values[i]));
                    }
                }
                
                return result;
            }
            return existing;
            
        case HIERA_MERGE_HASH:
            /* Hash merge, top-level keys only */
            if (existing->type == PUPPET_VALUE_HASH && new->type == PUPPET_VALUE_HASH) {
                puppet_value_t *result = puppet_value_copy(existing);
                
                /* Add/overwrite keys from new */
                puppet_hash_iterator_t *iter = puppet_hash_iterator_create(new->data.hash);
                const char *key;
                puppet_value_t *value;
                while (puppet_hash_iterator_next(iter, &key, &value)) {
                    puppet_hash_set(result->data.hash, key, strlen(key), puppet_value_copy(value));
                }
                puppet_hash_iterator_destroy(iter);
                
                return result;
            }
            return existing;
            
        case HIERA_MERGE_DEEP:
            /* Deep hash merge - recursive */
            if (existing->type == PUPPET_VALUE_HASH && new->type == PUPPET_VALUE_HASH) {
                puppet_value_t *result = puppet_value_copy(existing);
                
                puppet_hash_iterator_t *iter = puppet_hash_iterator_create(new->data.hash);
                const char *key;
                puppet_value_t *new_value;
                while (puppet_hash_iterator_next(iter, &key, &new_value)) {
                    puppet_value_t *existing_value = puppet_hash_get(result->data.hash, key, strlen(key));
                    
                    if (existing_value && existing_value->type == PUPPET_VALUE_HASH &&
                        new_value->type == PUPPET_VALUE_HASH) {
                        /* Recursive merge for nested hashes */
                        puppet_value_t *merged = puppet_hiera_merge_values(
                            existing_value, new_value, HIERA_MERGE_DEEP);
                        puppet_hash_set(result->data.hash, key, strlen(key), merged);
                    } else {
                        /* Overwrite non-hash values */
                        puppet_hash_set(result->data.hash, key, strlen(key), puppet_value_copy(new_value));
                    }
                }
                puppet_hash_iterator_destroy(iter);
                
                return result;
            }
            return existing;
            
        default:
            return existing;
    }
}

/**
 * @brief Perform Hiera lookup
 */
puppet_value_t *puppet_hiera_lookup(
    puppet_hiera_context_t *context,
    const char *key,
    puppet_value_t *default_value,
    puppet_hiera_merge_t merge_strategy
) {
    if (!context || !key) return default_value;
    
    /* Check cache first */
    puppet_value_t *cached = puppet_hash_get(context->config->cache, key, strlen(key));
    if (cached) {
        return cached;
    }
    
    puppet_value_t *result = NULL;
    
    /* Traverse hierarchy */
    for (puppet_hiera_level_t *level = context->config->hierarchy; level; level = level->next) {
        /* Interpolate path */
        char *path = puppet_hiera_interpolate(level->path_template, context);
        
        /* Build full path */
        char fullpath[1024];
        snprintf(fullpath, sizeof(fullpath), "%s/%s", level->datadir, path);
        puppet_free(path);
        
        /* Check if file exists */
        struct stat st;
        if (stat(fullpath, &st) != 0 || !S_ISREG(st.st_mode)) {
            continue;
        }
        
        /* Load YAML file */
        puppet_value_t *data = puppet_hiera_load_yaml(fullpath);
        if (data && data->type == PUPPET_VALUE_HASH) {
            puppet_value_t *value = puppet_hash_get(data->data.hash, key, strlen(key));
            
            if (value) {
                if (result) {
                    /* Merge with existing result */
                    puppet_value_t *merged = puppet_hiera_merge_values(result, value, merge_strategy);
                    if (merged != result) {
                        puppet_value_destroy(result);
                        result = merged;
                    }
                } else {
                    /* First value found */
                    result = puppet_value_copy(value);
                }
                
                /* For FIRST strategy, we're done */
                if (merge_strategy == HIERA_MERGE_FIRST) {
                    puppet_value_destroy(data);
                    break;
                }
            }
            
            puppet_value_destroy(data);
        }
    }
    
    /* Use default if nothing found */
    if (!result && default_value) {
        result = puppet_value_copy(default_value);
    }
    
    /* Cache the result */
    if (result) {
        puppet_hash_set(context->config->cache, key, strlen(key), puppet_value_copy(result));
    }
    
    return result;
}

/**
 * @brief Data provider lookup function
 */
puppet_value_t *puppet_hiera_data_provider_lookup(
    const char *key,
    struct puppet_env *env,
    void *provider_data
) {
    puppet_hiera_config_t *config = (puppet_hiera_config_t *)provider_data;
    if (!config) return NULL;
    
    puppet_hiera_context_t *context = puppet_hiera_context_create(config, env);
    puppet_value_t *result = puppet_hiera_lookup(context, key, NULL, config->default_merge);
    
    /* Need to copy result as context will be destroyed */
    puppet_value_t *copy = result ? puppet_value_copy(result) : NULL;
    puppet_hiera_context_destroy(context);
    
    return copy;
}

/**
 * @brief Initialize Hiera data provider
 */
int puppet_hiera_data_provider_init(void **provider_data, const char *config) {
    if (!provider_data) return -1;
    
    puppet_hiera_config_t *hiera_config = NULL;
    
    if (config) {
        /* Check if config is a file path to hiera.yaml */
        struct stat st;
        if (stat(config, &st) == 0 && S_ISREG(st.st_mode)) {
            hiera_config = puppet_hiera_config_create(config);
        } else {
            /* Assume it's a data directory */
            hiera_config = puppet_hiera_config_create_default(config);
        }
    } else {
        /* Use default configuration */
        hiera_config = puppet_hiera_config_create_default("data");
    }
    
    if (!hiera_config) {
        return -1;
    }
    
    *provider_data = hiera_config;
    return 0;
}

/**
 * @brief Cleanup Hiera data provider
 */
void puppet_hiera_data_provider_cleanup(void *provider_data) {
    if (provider_data) {
        puppet_hiera_config_destroy((puppet_hiera_config_t *)provider_data);
    }
}

/**
 * @brief Register Hiera as a data provider
 */
int puppet_hiera_register_provider(puppet_env_t *env, const char *config_path) {
    if (!env) return -1;
    
    puppet_data_provider_t *provider = puppet_calloc(1, sizeof(puppet_data_provider_t));
    provider->name = puppet_strdup("hiera");
    provider->lookup = puppet_hiera_data_provider_lookup;
    provider->init = puppet_hiera_data_provider_init;
    provider->cleanup = puppet_hiera_data_provider_cleanup;
    
    void *provider_data = NULL;
    if (provider->init(&provider_data, config_path) != 0) {
        puppet_free(provider->name);
        puppet_free(provider);
        return -1;
    }
    
    provider->data = provider_data;
    
    /* Register with environment */
    return puppet_env_register_data_provider(env, provider);
}