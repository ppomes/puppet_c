# Demo node image - Debian with puppetc-agent and systemd
# Fetches catalog from server and applies it on startup
# Services are managed by systemd (like real Puppet)

FROM debian:bookworm-slim AS builder

# Build puppetc packages
RUN apt-get update && apt-get install -y \
    build-essential autoconf automake libtool gawk pkg-config \
    libtree-sitter-dev libyaml-dev libssl-dev libmicrohttpd-dev \
    libcurl4-openssl-dev libsqlite3-dev ruby-dev debhelper devscripts \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . .

RUN autoreconf -i && dpkg-buildpackage -us -uc -b
RUN mkdir -p /packages && mv ../*.deb /packages/ 2>/dev/null || true

# Final image with systemd support
FROM antmelekhin/docker-systemd:debian-12

# Install runtime dependencies (including Ruby for custom types/providers)
# Note: libruby3.1 matches the version in debian:bookworm builder stage
RUN apt-get update && apt-get install -y --no-install-recommends \
    libcurl4 \
    libsqlite3-0 \
    ca-certificates \
    curl \
    procps \
    ruby \
    libruby3.1 \
    && rm -rf /var/lib/apt/lists/*

# Install puppetc-agent packages
COPY --from=builder /packages/libpuppetc-common0_*.deb /tmp/
COPY --from=builder /packages/libfacter-c0_*.deb /tmp/
COPY --from=builder /packages/puppetc-agent_*.deb /tmp/

RUN dpkg -i /tmp/libpuppetc-common0_*.deb \
            /tmp/libfacter-c0_*.deb \
            /tmp/puppetc-agent_*.deb && \
    rm -rf /tmp/*.deb

# Copy mysql module lib files for Ruby providers
COPY demo/modules/mysql/lib /var/lib/puppetc/lib/
COPY demo/modules/stdlib/lib /var/lib/puppetc/lib/

# Create a systemd service that runs puppetc-agent on boot
# Note: The service reads PUPPET_SERVER from /etc/default/puppetc-agent
RUN echo '[Unit]\n\
Description=Puppet-C Agent\n\
After=network.target\n\
\n\
[Service]\n\
Type=oneshot\n\
EnvironmentFile=-/etc/default/puppetc-agent\n\
ExecStartPre=/bin/sleep 3\n\
ExecStart=/usr/bin/puppetc-agent -a -v --ruby --allow-http --libdir /var/lib/puppetc/lib\n\
RemainAfterExit=yes\n\
\n\
[Install]\n\
WantedBy=multi-user.target\n\
' > /etc/systemd/system/puppetc-agent.service

# Create a startup script that copies container env to systemd environment file
RUN echo '#!/bin/bash\n\
echo "PUPPET_SERVER=$PUPPET_SERVER" > /etc/default/puppetc-agent\n\
exec /lib/systemd/systemd\n\
' > /entrypoint.sh && chmod +x /entrypoint.sh

# Enable the service
RUN systemctl enable puppetc-agent.service

# Use our entrypoint to pass container env to systemd
ENTRYPOINT ["/entrypoint.sh"]
