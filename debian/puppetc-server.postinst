#!/bin/sh
# postinst script for puppetc-server
# This script sets up the SSL/TLS infrastructure directories for the Puppet CA

set -e

case "$1" in
    configure)
        # Create SSL directory structure for Certificate Authority
        # The server uses puppet_ca_init() to initialize the CA on first startup
        # CA files will be stored in /etc/puppetc/ssl/ca/

        # Create main CA directory
        if [ ! -d /etc/puppetc/ssl/ca ]; then
            mkdir -p /etc/puppetc/ssl/ca
            chmod 755 /etc/puppetc/ssl/ca
        fi

        # Create directory for signed client certificates
        if [ ! -d /etc/puppetc/ssl/ca/signed ]; then
            mkdir -p /etc/puppetc/ssl/ca/signed
            chmod 755 /etc/puppetc/ssl/ca/signed
        fi

        # Create general SSL certificates directory
        if [ ! -d /etc/puppetc/ssl/certs ]; then
            mkdir -p /etc/puppetc/ssl/certs
            chmod 755 /etc/puppetc/ssl/certs
        fi

        # Create private keys directory with restricted permissions
        if [ ! -d /etc/puppetc/ssl/private ]; then
            mkdir -p /etc/puppetc/ssl/private
            chmod 700 /etc/puppetc/ssl/private
        fi

        # Ensure proper ownership (root:root)
        chown -R root:root /etc/puppetc/ssl

        # Note: The actual CA certificate and key (ca_crt.pem, ca_key.pem)
        # will be auto-generated by puppetc-server on first startup via
        # puppet_ca_init() if they don't already exist.
        # The CA private key will be saved with 0600 permissions automatically.
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        # Nothing to do
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
