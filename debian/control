Package: libpuppetc-common0
Section: libs
Architecture: any
Depends: ${shlibs:Depends}, ${misc:Depends}
Description: Puppet common library (memory management, JSON)
 Shared library with common utilities including memory
 management, tracking functions, and JSON parsing/generation.

Package: libpuppetc-common-dev
Section: libdevel
Architecture: any
Depends: libpuppetc-common0 (= ${binary:Version}), ${misc:Depends}
Description: Puppet common library - development files
 Development headers for libpuppetc_common.

Package: libpuppetc0
Section: libs
Architecture: any
Depends: libpuppetc-common0 (= ${binary:Version}),
         ${shlibs:Depends},
         ${misc:Depends}
Description: Puppet language parser and interpreter library
 libpuppetc is a C implementation of the Puppet language parser
 and interpreter. It provides parsing, AST generation, and
 manifest evaluation functionality.

Package: libpuppetc-dev
Section: libdevel
Architecture: any
Depends: libpuppetc0 (= ${binary:Version}), ${misc:Depends}
Description: Puppet language library - development files
 Development headers for libpuppetc.

Package: libfacter-c0
Section: libs
Architecture: any
Depends: libpuppetc-common0 (= ${binary:Version}),
         ${shlibs:Depends},
         ${misc:Depends}
Description: Native fact collection library
 libfacter_c collects system facts (hostname, OS, network, etc.)
 for use with Puppet manifests.

Package: libfacter-c-dev
Section: libdevel
Architecture: any
Depends: libfacter-c0 (= ${binary:Version}), ${misc:Depends}
Description: Fact collection library - development files
 Development headers for libfacter_c.

Package: puppetc
Architecture: any
Depends: libpuppetc0 (= ${binary:Version}),
         ${shlibs:Depends},
         ${misc:Depends}
Description: Puppet manifest compiler and catalog generator
 Command-line tool (puppetc-compile) for parsing, evaluating,
 and compiling Puppet manifests into catalogs. Also includes
 facter_c for collecting system facts.

Package: puppetc-server
Architecture: any
Depends: libpuppetc0 (= ${binary:Version}),
         ${shlibs:Depends},
         ${misc:Depends}
Description: Puppet catalog compilation server
 HTTP server that compiles Puppet catalogs for nodes.
 Provides a REST API compatible with Puppet Server.

Package: puppetc-agent
Architecture: any
Depends: libfacter-c0 (= ${binary:Version}),
         ${shlibs:Depends},
         ${misc:Depends}
Description: Puppet agent client
 Agent that collects system facts, requests catalogs from
 puppetc-server, and applies resources to the system.
